#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# BACKUP THE DATA DIRECTORY
#=================================================

ynh_print_info "Declaring files to be backed up..."

ynh_backup "$data_dir"

#=================================================
# BACKUP ENV AND SYSTEMD UNIT
#=================================================

# Only env + unit are archived: the frontend build, node_modules and the exercise
# media (catalogue/media/, served at /exercise-media/) are all reproducible from
# the pinned source tarball, so restore regenerates them by re-extracting + rebuild.
ynh_backup "$install_dir/env"
ynh_backup "/etc/systemd/system/$app.service"

#=================================================
# END OF SCRIPT
#=================================================
