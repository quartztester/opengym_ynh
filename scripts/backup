#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# BACKUP THE DATA DIRECTORY
#=================================================

ynh_print_info "Declaring files to be backed up..."

ynh_backup "$data_dir"

#=================================================
# BACKUP ENV AND SYSTEMD UNIT
#=================================================

# Only env + unit are archived: the frontend build and node_modules are reproducible from the tarball.
ynh_backup "$install_dir/env"
ynh_backup "/etc/systemd/system/$app.service"

# The exercise media dataset is big but not refetchable deterministically (unpinned third-party repo),
# so archive it when present. Absent when install chose download_media=false; ynh_backup errors on
# missing paths, hence the guard.
if [ -d "$install_dir/media" ]; then
    ynh_backup "$install_dir/media"
fi

#=================================================
# END OF SCRIPT
#=================================================
