#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# CUSTOM APPLY
#=================================================

# Re-render the mint lua and reload nginx so its lua code cache picks it up now (else up to 60s expiry delays the toggle).
ynh_app_config_apply() {
	_ynh_app_config_apply
	_opengym_sso_setup
	ynh_systemctl --service=nginx --action=reload
}

#=================================================
# RUN CONFIG PANEL ACTION
#=================================================
ynh_app_config_run $1
