#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# openGym derives URLs relative to the page and checks Origin/Referrer against ORIGIN (set from domain+path), so a subpath install works.

#=================================================
# SOURCE (TAGGED GITHUB RELEASE TARBALL)
#=================================================
ynh_script_progression "Downloading and extracting openGym sources..."
ynh_setup_source --dest_dir="$install_dir"

# The API imports ../api/coach/core from the frontend build, so the upstream repo layout must be preserved.
mkdir -p "$data_dir" "$install_dir/frontend/dist"
# data_dir holds accounts, the session secret and VAPID keys; the resource creates it world-readable, so tighten to group-only traversal.
chmod 750 "$data_dir"
chown -R "$app:$app" "$install_dir" "$data_dir"

#=================================================
# NODE DEPENDENCIES (PRODUCTION ONLY)
#=================================================
ynh_script_progression "Installing API dependencies (npm ci --omit=dev)..."
pushd "$install_dir/api" || exit 1
    npm ci --omit=dev --no-audit --no-fund
popd || exit 1

ynh_script_progression "Installing frontend build dependencies..."
pushd "$install_dir/frontend" || exit 1
    # --ignore-scripts: capacitor/sharp postinstall downloads libvips from GitHub for mobile icon builds — not needed for vite build (upstream's Dockerfile uses the same flag).
    npm ci --ignore-scripts --no-audit --no-fund
popd || exit 1

#=================================================
# ENVIRONMENT (PASSKEY RELYING PARTY ETC.)
#=================================================
ynh_script_progression "Writing environment file (RP_ID=__DOMAIN__ ORIGIN=https://__DOMAIN____PATH__)..."
domain=$(ynh_app_setting_get --key=domain)
# Passkeys bind to the origin: RP_ID is the registrable domain, ORIGIN the exact base the browser sends — the webauthn lib requires no trailing slash.
origin="https://${domain}"
cat > "$install_dir/env" <<EOF
RP_ID=${domain}
ORIGIN=${origin}
RP_NAME=openGym
FIRST_USER_ADMIN=1
TRUST_PROXY=1
EOF
# The API reads only ORIGIN/RP_* from env; TRUST_PROXY, data dir and port are pinned in the systemd unit.
chown "$app:$app" "$install_dir/env"
chmod 600 "$install_dir/env"

#=================================================
# FRONTEND BUILD (STATIC ASSETS)
#=================================================
ynh_script_progression "Building the frontend (vite build)..."
pushd "$install_dir/frontend" || exit 1
    APP_BUILD="ynh" npm run build
popd || exit 1
chown -R "$app:$app" "$install_dir"
# vite creates frontend/dist at 0750 owned by the build user, which 403s nginx (www-data); open traversal.
chmod o+x "$install_dir" "$install_dir/frontend" 2>/dev/null || true
chmod -R o+rX "$install_dir/frontend/dist" 2>/dev/null || true

#=================================================
# EXERCISE MEDIA (BUNDLED IN THE SOURCE TARBALL)
#=================================================
# The 6554 stills (.webp) + 6554 clips (.mp4) live at catalogue/media/ inside
# the upstream tarball — nothing is downloaded. nginx serves them read-only at
# __PATH__/exercise-media/ (see conf/nginx.conf); open traversal + read for
# www-data (install_dir defaults to 0750).
ynh_script_progression "Opening bundled exercise media for nginx..."
chmod o+x "$install_dir/catalogue" 2>/dev/null || true
chmod -R o+rX "$install_dir/catalogue/media" 2>/dev/null || true
chown -R "$app:$app" "$data_dir"

#=================================================
# SYSTEMD SERVICE (API)
#=================================================
ynh_script_progression "Configuring systemd service..."
ynh_config_add_systemd
yunohost service add "$app" --description="openGym API"
ynh_systemctl --service="$app" --action=start --log_path=systemd --timeout=60

#=================================================
# WAIT FOR THE API
#=================================================
ynh_script_progression "Waiting for the API to answer..."
waited=0
while [ "$waited" -lt 60 ]; do
    if curl -fsS -m 3 "http://127.0.0.1:$port/api/health" >/dev/null 2>&1 \
       || curl -fsS -m 3 "http://127.0.0.1:$port/" >/dev/null 2>&1 \
       || curl -s -m 3 -o /dev/null "http://127.0.0.1:$port/api/config" | grep -q .; then
        break
    fi
    sleep 2
    waited=$((waited + 2))
done
[ "$waited" -ge 60 ] && ynh_print_warn "API not answering on 127.0.0.1:$port after 60s — check: journalctl -u $app"

#=================================================
# PORTAL SSO WALK-IN (OPT-IN FEATURE, OFF BY DEFAULT)
#=================================================
ynh_script_progression "Setting up portal SSO walk-in login files..."
ynh_app_setting_set --key=sso_enabled --value="${sso_enabled:-0}"
ynh_app_setting_set --key=auto_provision --value="${auto_provision:-1}"
_opengym_sso_setup

#=================================================
# NGINX + PORT
#=================================================
ynh_script_progression "Configuring nginx..."
ynh_config_add_nginx

if [ -f "$YNH_APP_BASEDIR/doc/logo.png" ]; then
    cp "$YNH_APP_BASEDIR/doc/logo.png" "/usr/share/yunohost/applogos/$app.png"
    yunohost user permission update "$app.main" --logo "/usr/share/yunohost/applogos/$app.png" || true
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "openGym installation completed."
